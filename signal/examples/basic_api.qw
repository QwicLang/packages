import signal

public func getUser(req: any): any {
    const id = req.params["id"]
    return signal.Response.new(200, {"userId": id, "name": "Qwic User " + id.to_string()})
}

public func createItem(req: any): any {
    try {
        const data = req.body.validate({"title": "string", "priority": "int"})
        return signal.Response.new(201, {"status": "created", "item": data})
    } catch (e) {
        return signal.Response.new(400, {"error": e.message})
    }
}

public func main() {
    const app = signal.App.new()

    app.routes([
        {"path": "/user/{id:int}", "method": "GET", "handler": getUser},
        {"path": "/item", "method": "POST", "handler": createItem},
    ])

    app.run(8080)
}
