import json

public type Request {
    method: string
    path: string
    params: map
    body: Body
    headers: map
}

public type Body {
    raw: string
}

public func Body.validate(schema: map) -> map {
    const data = json.parse(this.raw)
    
    for key in schema.keys() {
        const expectedType = schema[key]
        const actualValue = data[key]
        
        if actualValue == null {
            throw signal.ValidationError("Missing required field: " + key)
        }
        
        // Type checking logic
        if expectedType == "int" && actualValue.type != "int" {
            throw signal.ValidationError("Field " + key + " must be an integer")
        }
        if expectedType == "string" && actualValue.type != "string" {
            throw signal.ValidationError("Field " + key + " must be a string")
        }
        if expectedType == "bool" && actualValue.type != "bool" {
            throw signal.ValidationError("Field " + key + " must be a boolean")
        }
    }
    
    return data
}
