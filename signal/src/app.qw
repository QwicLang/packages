import http
import json

// Signal App manages routing and server lifecycle
public type App {
    routes: list 
}

public func App.new(): App {
    return App { routes: [] }
}

// Registers a list of routes
public func App.routes(routeList: list) {
    this.routes = this.routes + routeList
}

// Starts the server on the specified port
public func App.run(port: int) {
    print(f"🚀 Signal server starting on port {port}")
    
    http.listen(port, (req) => {
        return this.dispatch(req)
    })
}

private func App.matchPath(pattern: string, path: string): bool {
    if pattern == path {
        return true
    }
    
    if pattern.contains("{") && path.split("/").length == pattern.split("/").length {
        return true
    }
    
    return false
}

private func App.extractParams(pattern: string, path: string): map {
    const patternParts = pattern.split("/")
    const pathParts = path.split("/")
    const params = {}
    
    for i in 0..patternParts.length - 1 {
        const pPart = patternParts[i]
        if pPart.starts_with("{") && pPart.ends_with("}") {
            const key = pPart.substring(1, pPart.length - 1)
            if key.contains(":") {
                const parts = key.split(":")
                const name = parts[0]
                const type = parts[1]
                params[name] = this.castValue(pathParts[i], type)
            } else {
                params[key] = pathParts[i]
            }
        }
    }
    return params
}

private func App.castValue(value: string, type: string): any {
    if type == "int" {
        return value.to_int()
    }
    if type == "bool" {
        return value == "true"
    }
    return value
}

private func App.dispatch(req: Request): Response {
    for route in this.routes {
        if route.method == req.method && this.matchPath(route.path, req.path) {
            req.params = this.extractParams(route.path, req.path)
            return route.handler(req)
        }
    }
    return Response.new(404, {"error": "Not Found"})
}
